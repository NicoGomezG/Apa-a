# Frontend (Angular). Copia este archivo a .env y complétalo.
# Solo valores PÚBLICOS: terminan dentro del JavaScript que descarga el navegador.
# Supabase → Project Settings → API.

# URL del proyecto, ej: https://abcdefghijkl.supabase.co
NG_APP_SUPABASE_URL=
# Clave PUBLICABLE (sb_publishable_…) o la "anon" heredada. NUNCA la secreta.
NG_APP_SUPABASE_PUBLISHABLE_KEY=
# true cuando Google esté configurado en Supabase → Authentication → Providers.
NG_APP_GOOGLE_AUTH_ENABLED=false
