# Backend (Fastify). Copia este archivo a backend/.env y complétalo.
# Estos valores son SECRETOS: nunca al repo, nunca al frontend.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Supabase → Project Settings → Database → Connection string.
# App en ejecución: pooler en modo transacción (puerto 6543).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Migraciones: conexión directa o pooler en modo sesión (puerto 5432).
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API.
SUPABASE_URL=https://<ref>.supabase.co
# Clave secreta (sb_secret_…) o service_role heredada. Solo para eliminar cuentas.
SUPABASE_SECRET_KEY=
# Solo si el proyecto todavía firma los JWT con el secreto HS256 heredado.
# Si usa claves de firma asimétricas (JWKS), déjalo vacío.
SUPABASE_JWT_SECRET=

# Orígenes permitidos (coma). En local el front usa el proxy de ng serve.
CORS_ORIGINS=http://localhost:4200
