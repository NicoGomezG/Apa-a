// Esquema de datos de Apaña.
//
// Todas las tablas viven en el schema `app` de Postgres, que NO está expuesto
// por la Data API de Supabase: solo el backend (`backend/`) lee y escribe acá.
// La identidad (correo, contraseña, OAuth) la maneja Supabase Auth en `auth.users`;
// `profiles.id` es el mismo UUID (`sub` del JWT).
//
// Convenciones: PK uuid, timestamps `timestamptz`, dinero en `BigInt` de unidad
// mínima + moneda (nunca Float), nombres en snake_case en la base.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

model Profile {
  id          String           @id @db.Uuid
  displayName String?          @map("display_name") @db.VarChar(80)
  /// Cumpleaños propio. Los amigos ven día y mes (nunca el año).
  birthDay    Int?             @map("birth_day") @db.SmallInt
  birthMonth  Int?             @map("birth_month") @db.SmallInt
  birthYear   Int?             @map("birth_year") @db.SmallInt
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  preferences UserPreferences?

  @@map("profiles")
  @@schema("app")
}

model UserPreferences {
  userId    String   @id @map("user_id") @db.Uuid
  timezone  String   @default("America/Santiago") @db.VarChar(64)
  locale    String   @default("es-CL") @db.VarChar(16)
  currency  String   @default("CLP") @db.Char(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile   Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
  @@schema("app")
}

// Bitácora de acciones relevantes. `user_id` no es FK a propósito: el registro
// sobrevive a la eliminación de la cuenta, y no guarda datos personales en
// `metadata` (solo identificadores y nombres de campos).
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(64)
  entityType String?  @map("entity_type") @db.VarChar(64)
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
  @@schema("app")
}

// ---------------------------------------------------------------------------
// Finanzas
//
// Montos: BigInt en unidad mínima con signo (negativo = sale plata, positivo =
// entra) + `currency`. Días sin hora: `date`. Los movimientos importados llevan
// `dedupe_key` (huella) para que subir dos veces la misma cartola no duplique.

model FinancialAccount {
  id            String            @id @default(uuid(7)) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  name          String            @db.VarChar(80)
  /// checking | savings | credit_card | cash | other
  kind          String            @db.VarChar(16)
  institution   String?           @db.VarChar(60)
  /// Solo los últimos 4 dígitos, nunca el número completo.
  last4         String?           @db.VarChar(4)
  currency      String            @default("CLP") @db.Char(3)
  creditLimit   BigInt?           @map("credit_limit")
  /// Tarjetas: día de cierre de facturación (1–31).
  billingDay    Int?              @map("billing_day") @db.SmallInt
  /// Tarjetas: día de pago (1–31).
  paymentDay    Int?              @map("payment_day") @db.SmallInt
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  transactions  Transaction[]
  plans         InstallmentPlan[]
  statements    CardStatement[]
  subscriptions Subscription[]

  @@index([userId])
  @@map("financial_accounts")
  @@schema("app")
}

model Transaction {
  id          String           @id @default(uuid(7)) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  accountId   String           @map("account_id") @db.Uuid
  date        DateTime         @db.Date
  description String           @db.VarChar(200)
  amount      BigInt
  currency    String           @db.Char(3)
  /// expense | income | transfer | card_payment
  kind        String           @db.VarChar(16)
  category    String?          @db.VarChar(32)
  /// manual | import
  source      String           @default("manual") @db.VarChar(16)
  dedupeKey   String?          @map("dedupe_key") @db.VarChar(64)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, dedupeKey])
  @@index([userId, date])
  @@map("transactions")
  @@schema("app")
}

/// Compra en cuotas. Las cuotas no se guardan una por una: se calculan desde
/// `first_due_month` (mes en que se paga la cuota 1). La última cuota es
/// total − (N−1) × valor cuota, igual que lo calculan los bancos.
model InstallmentPlan {
  id                    String           @id @default(uuid(7)) @db.Uuid
  userId                String           @map("user_id") @db.Uuid
  accountId             String           @map("account_id") @db.Uuid
  description           String           @db.VarChar(200)
  purchaseDate          DateTime         @map("purchase_date") @db.Date
  originalAmount        BigInt           @map("original_amount")
  totalAmount           BigInt           @map("total_amount")
  installmentCount      Int              @map("installment_count") @db.SmallInt
  installmentAmount     BigInt           @map("installment_amount")
  /// Valor real de la última cuota, si el estado de cuenta la mostró (a veces
  /// el banco no ajusta el redondeo). Si es null: total − (N−1) × cuota.
  lastInstallmentAmount BigInt?          @map("last_installment_amount")
  firstDueMonth         DateTime         @map("first_due_month") @db.Date
  currency              String           @db.Char(3)
  category              String?          @db.VarChar(32)
  dedupeKey             String           @map("dedupe_key") @db.VarChar(64)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  account               FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, dedupeKey])
  @@index([userId])
  @@map("installment_plans")
  @@schema("app")
}

/// Datos clave de un estado de cuenta de tarjeta (el archivo no se guarda).
model CardStatement {
  id             String           @id @default(uuid(7)) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  accountId      String           @map("account_id") @db.Uuid
  periodStart    DateTime         @map("period_start") @db.Date
  periodEnd      DateTime         @map("period_end") @db.Date
  dueDate        DateTime         @map("due_date") @db.Date
  totalBilled    BigInt           @map("total_billed")
  minimumPayment BigInt           @map("minimum_payment")
  currency       String           @db.Char(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  account        FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, periodEnd])
  @@index([userId, dueDate])
  @@map("card_statements")
  @@schema("app")
}

model Subscription {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  name      String            @db.VarChar(80)
  amount    BigInt
  currency  String            @default("CLP") @db.Char(3)
  /// monthly | yearly
  frequency String            @db.VarChar(8)
  /// Fecha del primer cobro; de ahí salen el día de cobro y los siguientes.
  startDate DateTime          @map("start_date") @db.Date
  accountId String?           @map("account_id") @db.Uuid
  category  String?           @db.VarChar(32)
  active    Boolean           @default(true)
  /// Correo de la cuenta con que se contrató el servicio.
  email     String?           @db.VarChar(254)
  /// Notas libres (plan, quién la usa, cómo darla de baja…).
  notes     String?           @db.VarChar(500)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  account   FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("subscriptions")
  @@schema("app")
}

// --- Personas -------------------------------------------------------------------

model Contact {
  id           String             @id @default(uuid(7)) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  name         String             @db.VarChar(80)
  nickname     String?            @db.VarChar(40)
  /// Cumpleaños: día y mes; el año es opcional (solo para calcular la edad).
  birthDay     Int?               @map("birth_day") @db.SmallInt
  birthMonth   Int?               @map("birth_month") @db.SmallInt
  birthYear    Int?               @map("birth_year") @db.SmallInt
  phone        String?            @db.VarChar(30)
  email        String?            @db.VarChar(254)
  /// familia | amistad | pareja | trabajo | otro
  relationship String?            @db.VarChar(16)
  notes        String?            @db.VarChar(500)
  /// Amigo de Apaña al que corresponde este contacto (uno por amigo).
  friendUserId String?            @map("friend_user_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  participants SplitParticipant[]

  @@unique([userId, friendUserId])
  @@index([userId])
  @@map("contacts")
  @@schema("app")
}

/// Grupo o salida con gastos compartidos (estilo Tricount).
model SplitGroup {
  id           String             @id @default(uuid(7)) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  name         String             @db.VarChar(80)
  date         DateTime?          @db.Date
  currency     String             @default("CLP") @db.Char(3)
  /// Código del enlace de solo lectura para invitados; null = sin enlace.
  shareToken   String?            @unique @map("share_token") @db.VarChar(64)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  participants SplitParticipant[]
  expenses     SplitExpense[]
  settlements  SplitSettlement[]

  @@index([userId])
  @@map("split_groups")
  @@schema("app")
}

model SplitParticipant {
  id               String            @id @default(uuid(7)) @db.Uuid
  groupId          String            @map("group_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  name             String            @db.VarChar(80)
  contactId        String?           @map("contact_id") @db.Uuid
  /// La persona dueña del grupo.
  isMe             Boolean           @default(false) @map("is_me")
  /// Amigo con cuenta en Apaña que ve el grupo y puede informar pagos.
  linkedUserId     String?           @map("linked_user_id") @db.Uuid
  /// Último recordatorio de pago enviado a este amigo.
  remindedAt       DateTime?         @map("reminded_at") @db.Timestamptz(6)
  position         Int               @db.SmallInt
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  group            SplitGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact          Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  paidExpenses     SplitExpense[]
  shares           SplitShare[]
  settlementsSent  SplitSettlement[] @relation("SettlementFrom")
  settlementsTaken SplitSettlement[] @relation("SettlementTo")

  @@index([groupId])
  @@index([userId])
  @@index([linkedUserId])
  @@map("split_participants")
  @@schema("app")
}

model SplitExpense {
  id          String             @id @default(uuid(7)) @db.Uuid
  groupId     String             @map("group_id") @db.Uuid
  userId      String             @map("user_id") @db.Uuid
  description String             @db.VarChar(120)
  date        DateTime           @db.Date
  payerId     String             @map("payer_id") @db.Uuid
  /// equal | exact | items
  mode        String             @db.VarChar(8)
  /// Consumo sin propina (unidad mínima).
  subtotal    BigInt
  tipPercent  Int                @default(0) @map("tip_percent") @db.SmallInt
  tip         BigInt             @default(0)
  total       BigInt
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  group       SplitGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer       SplitParticipant   @relation(fields: [payerId], references: [id], onDelete: NoAction)
  items       SplitExpenseItem[]
  shares      SplitShare[]

  @@index([groupId])
  @@index([userId])
  @@map("split_expenses")
  @@schema("app")
}

/// Línea de una boleta, asignada a una o más personas.
model SplitExpenseItem {
  id             String       @id @default(uuid(7)) @db.Uuid
  expenseId      String       @map("expense_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  description    String       @db.VarChar(120)
  quantity       Int          @db.SmallInt
  unitPrice      BigInt       @map("unit_price")
  amount         BigInt
  participantIds String[]     @map("participant_ids") @db.Uuid
  position       Int          @db.SmallInt
  expense        SplitExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@map("split_expense_items")
  @@schema("app")
}

/// Lo que le corresponde a cada persona en un gasto (calculado por el backend).
model SplitShare {
  expenseId     String           @map("expense_id") @db.Uuid
  participantId String           @map("participant_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  consumption   BigInt
  tip           BigInt           @default(0)
  expense       SplitExpense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  participant   SplitParticipant @relation(fields: [participantId], references: [id], onDelete: NoAction)

  @@id([expenseId, participantId])
  @@index([participantId])
  @@map("split_shares")
  @@schema("app")
}

/// Pago entre personas del grupo para saldar deudas.
model SplitSettlement {
  id         String           @id @default(uuid(7)) @db.Uuid
  groupId    String           @map("group_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  fromId     String           @map("from_id") @db.Uuid
  toId       String           @map("to_id") @db.Uuid
  amount     BigInt
  date       DateTime         @db.Date
  /// false = informado por un amigo y aún sin confirmar por el dueño (no cuenta en los saldos).
  confirmed  Boolean          @default(true)
  /// Amigo que informó el pago; null si lo registró el dueño.
  reportedBy String?          @map("reported_by") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  group      SplitGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from       SplitParticipant @relation("SettlementFrom", fields: [fromId], references: [id], onDelete: NoAction)
  to         SplitParticipant @relation("SettlementTo", fields: [toId], references: [id], onDelete: NoAction)

  @@index([groupId])
  @@index([userId])
  @@map("split_settlements")
  @@schema("app")
}

/// Invitación de amistad por enlace: un solo uso, vence a los 7 días.
model FriendInvite {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  code      String   @unique @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("friend_invites")
  @@schema("app")
}

/// Amistad entre dos cuentas. Se guarda una sola fila por par, con user_a_id < user_b_id.
model Friendship {
  id        String   @id @default(uuid(7)) @db.Uuid
  userAId   String   @map("user_a_id") @db.Uuid
  userBId   String   @map("user_b_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("friendships")
  @@schema("app")
}
